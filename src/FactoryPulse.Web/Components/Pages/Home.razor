@page "/"
@rendermode InteractiveServer
@implements IAsyncDisposable
@inject IMachineSimulation MachineSimulation
@inject IProductionEventStore EventStore

<PageTitle>FactoryPulse | Live Dashboard</PageTitle>

<div class="dashboard-shell">
    <header class="dashboard-header">
        <div>
            <p class="eyebrow">Manufacturing monitor</p>
            <h1>FactoryPulse</h1>
        </div>
        <div class="simulation-label">
            <span class="simulation-dot" aria-hidden="true"></span>
            Simulated data
        </div>
    </header>

    @if (persistenceHealth.Status != PersistenceHealthStatus.Healthy)
    {
        <section class="persistence-alert persistence-@persistenceHealth.Status.ToString().ToLowerInvariant()"
                 role="alert"
                 aria-labelledby="persistence-heading">
            <div>
                <p class="section-label">Event persistence</p>
                <h2 id="persistence-heading">@GetPersistenceHeading(persistenceHealth.Status)</h2>
                <p>@persistenceHealth.Message</p>
            </div>
            <div class="persistence-count">
                <span>Accepted but not yet durable</span>
                <strong>@persistenceHealth.PendingEventCount / @persistenceHealth.QueueCapacity</strong>
            </div>
        </section>
    }

    <section class="machine-panel" aria-labelledby="machine-name">
        <div class="machine-heading">
            <div>
                <p class="section-label">Production asset</p>
                <h2 id="machine-name">@machine.MachineName</h2>
                <p class="machine-id">ID: @machine.MachineId</p>
            </div>
            <div class="status-pill status-@machine.CurrentState.ToString().ToLowerInvariant()">
                <span class="status-indicator" aria-hidden="true"></span>
                @machine.CurrentState
            </div>
        </div>

        <div class="metric-grid">
            <article class="metric-card primary-metric">
                <p>Completed units</p>
                <strong>@machine.CompletedUnitCount.ToString("N0")</strong>
            </article>
            <article class="metric-card">
                <p>Good units</p>
                <strong>@machine.GoodUnitCount.ToString("N0")</strong>
            </article>
            <article class="metric-card">
                <p>Rejected units</p>
                <strong>@machine.RejectedUnitCount.ToString("N0")</strong>
            </article>
        </div>
        <p class="session-note">
            Production totals reset when the app restarts. An uncleared fault is restored; otherwise the machine starts Idle.
        </p>

        <div class="controls-panel" aria-labelledby="controls-heading">
            <div>
                <p class="section-label">Simulated controls</p>
                <h3 id="controls-heading">Operator commands</h3>
            </div>
            <div class="control-buttons">
                <button type="button"
                        class="control-button start-button"
                        disabled="@(machine.CurrentState != MachineState.Idle || !PersistenceIsHealthy)"
                        @onclick="StartMachine">
                    Start
                </button>
                <button type="button"
                        class="control-button"
                        disabled="@(machine.CurrentState != MachineState.Running || !PersistenceIsHealthy)"
                        @onclick="StopMachine">
                    Stop
                </button>
                <button type="button"
                        class="control-button fault-button"
                        disabled="@(machine.CurrentState is not (MachineState.Running or MachineState.Idle) || !PersistenceIsHealthy)"
                        @onclick="InjectFault">
                    Inject Fault
                </button>
                <button type="button"
                        class="control-button clear-button"
                        disabled="@(machine.CurrentState != MachineState.Faulted || !PersistenceIsHealthy)"
                        @onclick="ClearFault">
                    Clear Fault
                </button>
            </div>
            @if (commandMessage is not null)
            {
                <p class="command-message" role="status">@commandMessage</p>
            }
        </div>

        @if (machine.ActiveFault is not null)
        {
            <aside class="fault-panel" aria-labelledby="active-fault-heading">
                <div>
                    <p class="section-label fault-label">Active fault</p>
                    <h3 id="active-fault-heading">
                        @machine.ActiveFault.Code — @machine.ActiveFault.Description
                    </h3>
                    <p>
                        Raised
                        <time datetime="@machine.ActiveFault.StartedAtUtc.ToString("O")">
                            @machine.ActiveFault.StartedAtUtc.ToString("yyyy-MM-dd HH:mm:ss 'UTC'")
                        </time>
                    </p>
                </div>
                <div class="downtime-value">
                    <span>Fault downtime</span>
                    <strong>@FormatDuration(machine.ActiveFault.ElapsedDuration)</strong>
                </div>
            </aside>
        }
    </section>

    <section class="events-panel" aria-labelledby="events-heading">
        <div class="events-heading">
            <div>
                <p class="section-label">Persistent activity</p>
                <h2 id="events-heading">Recent machine events</h2>
            </div>
            <span class="event-count">Latest 20</span>
        </div>

        @if (recentEvents.Count == 0)
        {
            <div class="empty-state">
                <p>Waiting for the first machine event…</p>
            </div>
        }
        else
        {
            <div class="event-table-wrapper">
                <table class="event-table">
                    <thead>
                        <tr>
                            <th>Time</th>
                            <th>Machine</th>
                            <th>Event</th>
                            <th>Details</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var productionEvent in recentEvents)
                        {
                            <tr>
                                <td>
                                    <time datetime="@productionEvent.Timestamp.ToString("O")">
                                        @productionEvent.Timestamp.ToLocalTime().ToString("MMM d, yyyy · HH:mm:ss")
                                    </time>
                                </td>
                                <td>@productionEvent.MachineId</td>
                                <td>
                                    <span class="event-type event-@productionEvent.EventType.ToString().ToLowerInvariant()">
                                        @GetEventLabel(productionEvent.EventType)
                                    </span>
                                </td>
                                <td>@GetEventDetails(productionEvent)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>

@code {
    private readonly CancellationTokenSource refreshCancellation = new();
    private MachineSnapshot machine = new(
        "machine-01", "Machine 01", MachineState.Idle, 0, 0, 0, null);
    private IReadOnlyList<ProductionEvent> recentEvents = [];
    private PersistenceHealthSnapshot persistenceHealth = new(
        PersistenceHealthStatus.Healthy, 0, 100, null);
    private PeriodicTimer? refreshTimer;
    private Task? refreshTask;
    private string? commandMessage;

    protected override async Task OnInitializedAsync()
    {
        await RefreshSnapshotsAsync();
        refreshTimer = new PeriodicTimer(TimeSpan.FromSeconds(1));
        refreshTask = RefreshDashboardAsync(refreshCancellation.Token);
    }

    private async Task RefreshDashboardAsync(CancellationToken cancellationToken)
    {
        try
        {
            while (refreshTimer is not null &&
                   await refreshTimer.WaitForNextTickAsync(cancellationToken))
            {
                await InvokeAsync(async () =>
                {
                    await RefreshSnapshotsAsync(cancellationToken);
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
            // Expected when the component is removed or the circuit closes.
        }
    }

    private Task StartMachine() =>
        ExecuteCommandAsync("Start", MachineSimulation.TryStart);

    private Task StopMachine() =>
        ExecuteCommandAsync("Stop", MachineSimulation.TryStop);

    private Task InjectFault() =>
        ExecuteCommandAsync("Inject Fault", MachineSimulation.TryInjectFault);

    private Task ClearFault() =>
        ExecuteCommandAsync("Clear Fault", MachineSimulation.TryClearFault);

    private async Task ExecuteCommandAsync(string commandName, Func<bool> command)
    {
        var accepted = command();
        var persistenceFailed = false;
        if (accepted)
        {
            try
            {
                await EventStore.FlushAsync(refreshCancellation.Token);
            }
            catch (PersistenceUnavailableException)
            {
                persistenceFailed = true;
            }
        }

        await RefreshSnapshotsAsync(refreshCancellation.Token);
        commandMessage = (accepted, persistenceFailed, PersistenceIsHealthy) switch
        {
            (true, false, true) => $"{commandName} command accepted and persisted.",
            (true, true, _) =>
                $"{commandName} changed the simulator, but its event was not persisted. Simulation activity is interlocked.",
            (false, _, false) =>
                $"{commandName} command rejected because event persistence is {persistenceHealth.Status}.",
            _ => $"{commandName} command rejected while the machine is {machine.CurrentState}."
        };
    }

    private async Task RefreshSnapshotsAsync(CancellationToken cancellationToken = default)
    {
        machine = MachineSimulation.GetMachineSnapshot();
        persistenceHealth = EventStore.GetHealthSnapshot();

        if (persistenceHealth.Status == PersistenceHealthStatus.Unavailable)
        {
            return;
        }

        try
        {
            recentEvents = await EventStore.GetRecentEventsAsync(
                MachineSimulator.MaximumRecentEventCount,
                cancellationToken);
        }
        catch (PersistenceUnavailableException)
        {
            persistenceHealth = EventStore.GetHealthSnapshot();
        }
    }

    private bool PersistenceIsHealthy =>
        persistenceHealth.Status == PersistenceHealthStatus.Healthy;

    private static string GetPersistenceHeading(PersistenceHealthStatus status) => status switch
    {
        PersistenceHealthStatus.Retrying => "Database write retry in progress",
        PersistenceHealthStatus.Backpressured => "Event queue is full",
        PersistenceHealthStatus.Unavailable => "Event persistence unavailable",
        _ => "Event persistence healthy"
    };

    private static string GetEventLabel(ProductionEventType eventType) => eventType switch
    {
        ProductionEventType.MachineStarted => "Machine started",
        ProductionEventType.MachineStopped => "Machine stopped",
        ProductionEventType.FaultRaised => "Fault raised",
        ProductionEventType.FaultCleared => "Fault cleared",
        ProductionEventType.UnitCompleted => "Unit completed",
        _ => eventType.ToString()
    };

    private static string GetEventDetails(ProductionEvent productionEvent) =>
        productionEvent.Duration is { } duration
            ? $"{productionEvent.Details} · Duration {FormatDuration(duration)}"
            : productionEvent.Details;

    private static string FormatDuration(TimeSpan duration) =>
        $"{(int)duration.TotalHours:00}:{duration.Minutes:00}:{duration.Seconds:00}";

    public async ValueTask DisposeAsync()
    {
        await refreshCancellation.CancelAsync();
        refreshTimer?.Dispose();

        if (refreshTask is not null)
        {
            await refreshTask;
        }

        refreshCancellation.Dispose();
    }
}
